# The generated images have no file extension, so set their type here.
/icon
  Content-Type: image/png
/apple-icon
  Content-Type: image/png
/opengraph-image*
  Content-Type: image/png
/pt-br/opengraph-image*
  Content-Type: image/png
/:tool/opengraph-image*
  Content-Type: image/png
/pt-br/:tool/opengraph-image*
  Content-Type: image/png

# Security headers for every response. Scripts may only come from this site
# and Cloudflare Web Analytics. Next.js needs inline scripts and styles.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  X-Frame-Options: DENY
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; connect-src 'self' https://cloudflareinsights.com; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; manifest-src 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; frame-ancestors 'none'

# Build files have a content hash in their name, so they never change.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# The logos and screenshots rarely change, so browsers can reuse them for a week instead of
# checking with the server on every load, which made them pop in late.
/dobrigado/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/tools/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
